  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Following these changes, the dragon and I had taken the time to quench each other's smoldering hearts red-hot with yearning.\r\nOur remaining embers never truly extinguish.\r\nFor they are resilient to each other with the potential to spark whole new fires between us.\r\r\nThis continued cycle of smothering and reigniting is how I know my love with the dragon shall last."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c20513514072d644481a7870482beadf, type: 2}
