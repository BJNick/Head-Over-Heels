  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '"Welcome my dear. I thought you''d have forgotten me for but a moment.

    Alas, your persistence to reach me has tugged the strings to play music with my heart.

    Say, your words though brash carry your elegance that harmonizes with my heart."'
  m_isRightToLeft: 0
