  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Those who succumb many years ago now spirits,

    Shielding shallow egos and royalties behind the elegance of history.

    I am unconcerned with such a fate.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c20513514072d644481a7870482beadf, type: 2}
