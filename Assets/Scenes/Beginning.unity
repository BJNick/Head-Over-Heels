  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '"You think such old tales carry weight after past centuries?

    Besides, I''m no stranger to these woods myself.

    Which leads to why I chose to seek you out."'
  m_isRightToLeft: 0
